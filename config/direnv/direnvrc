use_nvm() {
  watch_file .nvmrc
  local NVM_PATH="$HOME/.nvm/nvm.sh"
  if ! [ -f "$NVM_PATH" ]; then
    echo "Installing NVM" >&2
    curl -o- https://raw.githubusercontent.com/creationix/nvm/master/install.sh | bash
  fi
  . "${NVM_PATH}"
  nvm install
  layout node
}

layout_poetry() {
  if [[ ! -f pyproject.toml ]]; then
    log_error 'No pyproject.toml found.  Use `poetry new` or `poetry init` to create one first.'
    exit 2
  fi

  local VENV=$(dirname $(poetry run which python))
  export VIRTUAL_ENV=$(echo "$VENV" | rev | cut -d'/' -f2- | rev)
  export POETRY_ACTIVE=1
  PATH_add "$VENV"
}

# Standard project tooling environment: .hatch is the venv itself, not a parent
# directory containing named environments. Create/sync it explicitly with Hatch.
layout_hatch() {
  watch_file hatch.toml
  watch_file pyproject.toml
  watch_file .hatch/pyvenv.cfg

  if [[ ! -x .hatch/bin/python ]]; then
    log_error 'Missing .hatch environment. Run hatch env create, then direnv reload.'
    return 1
  fi

  export VIRTUAL_ENV="$PWD/.hatch"
  export HATCH_ENV=default
  export HATCH_ENV_TYPE_VIRTUAL_PATH="$VIRTUAL_ENV"
  export PYTHONNOUSERSITE=1
  export PIP_REQUIRE_VIRTUALENV=true
  unset PYTHONHOME
  PATH_add .hatch/bin
}
